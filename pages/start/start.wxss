.start-page {
  background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 64rpx;
}
.start-hero {
  text-align: center;
  padding-bottom: 60rpx;
}
.start-logo {
  width: 148rpx; height: 148rpx; margin: 0 auto 44rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #07C160, #0aa85a);
  color: #fff; font-size: 68rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 24rpx 52rpx rgba(7, 193, 96, 0.28);
}
.start-title { font-size: 44rpx; font-weight: 700; color: #1a1a1a; letter-spacing: 1rpx; }
.start-sub { color: var(--text-3); margin: 22rpx auto 0; font-size: 26rpx; line-height: 1.7; max-width: 496rpx; }

.start-body { width: 100%; }
.start-nick {
  width: 100%; max-width: 640rpx; margin: 0 auto;
  background: #f7f8fa; border-radius: 24rpx; padding: 24rpx 28rpx; box-sizing: border-box;
}
.sn-label { font-size: 26rpx; color: var(--text-3); }
.sn-input {
  width: 100%; box-sizing: border-box; height: 80rpx; margin-top: 8rpx;
  font-size: 32rpx; color: #1a1a1a;
}
.sn-ph { color: #bcbcbc; }
.start-actions { width: 100%; max-width: 640rpx; margin: 44rpx auto 0; }
.start-btn {
  width: 100%; padding: 30rpx; border-radius: 28rpx; border: none;
  font-size: 32rpx; font-weight: 600; line-height: 1;
  display: flex; align-items: center; justify-content: center; gap: 16rpx;
  transition: transform .15s;
}
.start-btn:active { transform: scale(.97); }
.start-btn .si { width: 40rpx; height: 40rpx; flex: none; }
.start-btn.create { background: var(--brand); color: #fff; box-shadow: 0 16rpx 36rpx rgba(7, 193, 96, 0.25); }
.start-btn.join { background: #fff; color: var(--brand); border: 2rpx solid #cdeedd; margin-top: 28rpx; }

.start-note { text-align: center; color: #c2c2c2; margin: 56rpx auto 0; font-size: 23rpx; line-height: 1.6; max-width: 536rpx; }

/* 创建家庭弹层：对照原型 #cMask / #cSheet（px × 2 = rpx） */
.c-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 90;
  opacity: 0; pointer-events: none; transition: opacity .25s;
}
.c-mask.show { opacity: 1; pointer-events: auto; }
.c-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 91;
  background: #fff; border-radius: 40rpx 40rpx 0 0;
  padding: 44rpx 36rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform .28s cubic-bezier(.2, .8, .2, 1), visibility .28s;
  visibility: hidden;
}
.c-sheet.show { transform: none; visibility: visible; }
.c-title { font-size: 34rpx; font-weight: 600; text-align: center; }
.c-sub { font-size: 24rpx; color: var(--text-3); text-align: center; margin-top: 12rpx; line-height: 1.6; }
.c-input {
  width: 100%; box-sizing: border-box; height: 92rpx;
  margin-top: 32rpx; padding: 0 28rpx;
  border: 2rpx solid #e6e6e6; border-radius: 24rpx; font-size: 30rpx;
}
.c-input.focus { border-color: var(--brand); }
.c-ph { color: #ccc; }
.c-ok {
  margin-top: 32rpx; background: var(--brand); color: #fff;
  border-radius: 24rpx; padding: 26rpx 0; font-size: 30rpx; font-weight: 600; text-align: center;
}
.c-ok.disabled { opacity: .7; }
.c-cancel {
  margin-top: 20rpx; background: #F2F3F5; color: #555;
  border-radius: 24rpx; padding: 26rpx 0; font-size: 30rpx; font-weight: 600; text-align: center;
}
.press { opacity: .85; }

/* 多家庭选择列表 */
.fam-pick { margin-bottom: 40rpx; }
.fp-title { font-size: 28rpx; color: #9a9a9a; margin: 0 8rpx 20rpx; }
.fp-item {
  display: flex; align-items: center; gap: 24rpx;
  background: #fff; border-radius: 28rpx; padding: 28rpx 32rpx;
}
.fp-item + .fp-item { margin-top: 20rpx; }
.fp-item:active { background: #fafafa; }
.fp-av {
  width: 84rpx; height: 84rpx; border-radius: 26rpx; flex: none;
  background: linear-gradient(135deg, #07C160, #0aa85a);
  color: #fff; font-size: 34rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.fp-info { flex: 1; min-width: 0; }
.fp-name { font-size: 31rpx; font-weight: 600; }
.fp-sub { font-size: 23rpx; color: #9a9a9a; margin-top: 8rpx; }
.fp-chev { color: #cfcfcf; font-size: 34rpx; }

.loading-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.6);
  display: flex; align-items: center; justify-content: center; z-index: 50;
}
.loading-box { background: rgba(0,0,0,0.7); color: #fff; padding: 20rpx 40rpx; border-radius: 12rpx; font-size: 28rpx; }

/* 隐私授权弹窗 */
.privacy-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,.5);
  display: flex; align-items: center; justify-content: center; z-index: 100; padding: 0 56rpx;
}
.privacy-dlg {
  width: 100%; background: #fff; border-radius: 36rpx; padding: 44rpx 40rpx 36rpx;
  box-shadow: 0 40rpx 100rpx rgba(0,0,0,.3); animation: pdpop .25s ease;
}
@keyframes pdpop { from { transform: scale(.92); opacity: 0 } to { transform: scale(1); opacity: 1 } }
.pd-title { font-size: 34rpx; font-weight: 700; text-align: center; margin-bottom: 24rpx; }
.pd-text { font-size: 27rpx; color: #444; line-height: 1.78; }
.pd-link {
  display: block; width: 100%; text-align: center; color: var(--brand); font-size: 27rpx;
  background: none; border: none; margin: 28rpx 0 4rpx; font-weight: 600; padding: 0;
}
.pd-link::after { border: none; }
.pd-warn { display: none; color: var(--expense); font-size: 25rpx; text-align: center; margin: 4rpx 0 8rpx; }
.pd-warn.show { display: block; }
.pd-btns { display: flex; gap: 24rpx; margin-top: 20rpx; }
.pd-refuse, .pd-agree { flex: 1; border: none; border-radius: 24rpx; padding: 26rpx; font-size: 30rpx; font-weight: 600; }
.pd-refuse { background: #F2F3F5; color: #666; }
.pd-agree { background: var(--brand); color: #fff; }
.pd-refuse:active, .pd-agree:active { opacity: .85; }
