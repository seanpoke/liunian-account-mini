/* pages/detail/detail.wxss —— 对照 doc/家庭记账小程序原型.html 明细页（px × 2 = rpx） */
.chip-label { font-size: 24rpx; color: var(--text-3); margin: 16rpx 8rpx 8rpx; }
.chip-row { margin-bottom: 20rpx; }
.chip {
  display: inline-block; padding: 12rpx 26rpx; border-radius: 40rpx;
  background: #F2F3F5; font-size: 26rpx; color: #666; margin: 0 12rpx 12rpx 0;
}
.chip.on { background: var(--brand); color: #fff; font-weight: 600; }

.trans-card { background: #fff; border-radius: 28rpx; padding: 8rpx 28rpx; }
.day-block { padding-bottom: 8rpx; }
.date-head { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 4rpx 16rpx; }
.date-head .dh-d { font-size: 25rpx; font-weight: 600; color: #666; }
.date-head .dh-w { font-size: 22rpx; color: #bbb; font-weight: 400; }

.trans { display: flex; align-items: center; gap: 24rpx; padding: 24rpx 0; }
.trans + .trans { border-top: 2rpx solid var(--line); }
.ic {
  width: 80rpx; height: 80rpx; border-radius: 24rpx;
  background: #F2F3F5; display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; flex: none;
}
.mid { flex: 1; min-width: 0; }
.line1 { display: flex; align-items: baseline; justify-content: space-between; gap: 24rpx; }
.tcat-wrap { display: flex; align-items: center; min-width: 0; }
.tcat { font-size: 30rpx; font-weight: 600; color: #1a1a1a; white-space: nowrap; }
.img-tag {
  margin-left: 12rpx; padding: 0 10rpx;
  height: 32rpx; line-height: 32rpx; box-sizing: border-box;
  font-size: 20rpx; font-weight: 400; color: #8a8f99;
  background: #f2f3f5; border-radius: 8rpx; flex: none;
}
.note { font-size: 24rpx; color: var(--text-3); margin-top: 6rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.amt { font-size: 32rpx; font-weight: 600; white-space: nowrap; flex: none; }
.amt.expense { color: var(--expense); }
.amt.income { color: var(--income); }

.day-sum { display: flex; justify-content: flex-end; gap: 20rpx; font-size: 22rpx; color: #b0b0b0; padding: 12rpx 4rpx 24rpx; border-bottom: 2rpx solid var(--line); }
.day-sum .b { color: #888; font-weight: 600; }
.day-sum .income { color: var(--income); }
.day-sum .expense { color: var(--expense); }
