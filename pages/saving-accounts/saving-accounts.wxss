/* pages/saving-accounts/saving-accounts.wxss */
.pad { padding: 24rpx; }
.nav-action { font-size: 26rpx; color: var(--brand); padding: 12rpx 8rpx; }

.tip-card {
  background: var(--brand-soft);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.tip-t { display: block; font-size: 28rpx; font-weight: 600; color: #0b7a44; }
.tip-s { display: block; font-size: 22rpx; color: #4d8a6c; line-height: 1.6; margin-top: 8rpx; }

.list-card { background: var(--card); border-radius: 28rpx; padding: 0 28rpx; }
/* 列表末尾的虚线新增卡：跟着最后一条账户走，比把"新建"放导航栏更符合"再加一条"的直觉 */
.add-card {
  height: 104rpx;
  margin: 20rpx 0 24rpx;
  border: 2rpx dashed #cfd4da;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
}
.add-card:active { background: var(--brand-soft); }
.add-plus { font-size: 34rpx; font-weight: 600; margin-right: 8rpx; }
.add-t { font-size: 27rpx; }
.add-card.off { color: #b9bec7; border-color: #e5e7eb; }
.arow {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.arow:last-child { border-bottom: none; }
.aic {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  flex: none;
}
.amid { flex: 1; min-width: 0; }
.aname {
  font-size: 29rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}
.atag {
  margin-left: 12rpx;
  font-size: 19rpx;
  font-weight: 400;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}
.atag.sys { color: var(--brand); background: var(--brand-soft); }
.atag.off { color: #a0a0a0; background: #f2f3f5; }
.asub { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }
.aright { display: flex; align-items: center; }
.abal {
  font-size: 29rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.abal.muted { color: var(--text-3); }
.aarrow { color: #c9cdd4; font-size: 28rpx; margin-left: 10rpx; width: 20rpx; }

.foot-hint {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin: 24rpx 8rpx 60rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 40;
  opacity: 0;
  visibility: hidden;
  transition: opacity .2s;
}
.mask.show { opacity: 1; visibility: visible; }
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 88vh;
  overflow-y: auto;
  z-index: 41;
  transform: translateY(100%);
  visibility: hidden;
  transition: transform .26s ease, visibility .26s;
}
.sheet.show { transform: translateY(0); visibility: visible; }
.handle {
  width: 72rpx; height: 8rpx; border-radius: 4rpx;
  background: #e2e2e2; margin: 0 auto 20rpx;
}
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 20rpx; }

.info-card {
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 0 24rpx;
}
.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  font-size: 28rpx;
}
.lbl { color: var(--text); margin-right: 24rpx; }
.v-input { flex: 1; text-align: right; font-size: 28rpx; }
.ph { color: #c4c4c4; }

/* 手输 emoji：右对齐、字号放大一点，与网格里选中的大图标视觉一致 */
.icon-input { text-align: right; font-size: 34rpx; }
/* 网格直接跟在表单卡下面，不需要小标题 */
.icon-grid { display: flex; flex-wrap: wrap; margin-top: 28rpx; }
.ic-item {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  background: #f5f6f8;
  border: 3rpx solid transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin: 0 16rpx 16rpx 0;
}
.ic-item.on { border-color: var(--brand); background: var(--brand-soft); }

.err { font-size: 24rpx; color: var(--expense); margin-top: 16rpx; }
/* 用 view 实现的主按钮：必须显式 text-align:center，否则文字会贴左、看起来像被裁掉 */
.save {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 24rpx;
  background: var(--brand);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 32rpx;
  padding: 0;
  box-sizing: border-box;
}
.save:active { opacity: .9; }
.save.disabled { background: #c9cdd4; }
.hint { font-size: 23rpx; color: var(--text-3); line-height: 1.6; margin-top: 16rpx; }
