/* pages/record/record.wxss —— 底部滑出记账弹层，对照原型图尺寸 */

/* 透明底层：把默认 page 灰底盖住 */
.record-page {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 600; display: flex; flex-direction: column; justify-content: flex-end;
}
.record-backdrop {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .35);
  animation: fadeIn .25s ease forwards;
}
.record-sheet {
  position: relative; background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  animation: slideUp .35s cubic-bezier(.25, .1, .25, 1) forwards;
  max-height: 86vh; overflow-y: auto;
}
.record-page.closing .record-backdrop { animation: fadeOut .25s ease forwards; }
.record-page.closing .record-sheet { animation: slideDown .3s ease forwards; }

@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes slideDown { from { transform: translateY(0); } to { transform: translateY(100%); } }

/* 顶部拖拽指示条 */
.sheet-handle {
  width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #ddd;
  margin: 0 auto 28rpx;
}

/* 收/支 切换 */
.type-switch {
  display: flex; background: #f2f3f5; border-radius: 24rpx; padding: 8rpx; margin-bottom: 28rpx;
}
.type-opt {
  flex: 1; text-align: center; padding: 20rpx 0; border-radius: 18rpx;
  font-size: 30rpx; font-weight: 600; color: #646a73;
}
.on-expense { background: #fff; color: #1a1a1a; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }
.on-income { background: #fff; color: #1a1a1a; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.06); }

/* 金额 */
.amount-wrap {
  display: flex; align-items: center; justify-content: center;
  padding: 16rpx 0 28rpx;
}
.amount-input {
  flex: 1; font-size: 96rpx; font-weight: 700; text-align: center; color: #1a1a1a; height: 120rpx;
}
.amount-ph { color: #c8ccd2; }

/* 分类网格：原型 5 列 */
.cat-grid { display: flex; flex-wrap: wrap; padding: 16rpx 0; }
.cat-cell { width: 20%; display: flex; flex-direction: column; align-items: center; padding: 18rpx 0; }
.cat-ic {
  width: 96rpx; height: 96rpx; border-radius: 28rpx; font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
  background: #f2f3f5; color: #555;
}
.cat-ic.sel { background: var(--brand); color: #fff; }
.cat-name { font-size: 24rpx; margin-top: 12rpx; color: #646a73; }
.cat-name.sel { color: #1a1a1a; font-weight: 600; }

/* 日期/备注卡片 */
.info-card {
  background: #fff; border-radius: 24rpx;
  border: 1rpx solid #f0f0f0; margin-top: 16rpx;
}
.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 28rpx; font-size: 30rpx;
}
.info-label { color: #1a1a1a; }
.info-value { color: #333; }
.info-arrow { color: #999; margin-left: 8rpx; }
.info-line { height: 1rpx; background: #f0f0f0; margin: 0 28rpx; }
.note-input {
  flex: 1; text-align: right; font-size: 30rpx; color: #333; margin-left: 32rpx;
}
.note-input::placeholder { color: #bbb; }

/* 保存 */
.save-btn {
  width: 100%; height: 96rpx; line-height: 96rpx; text-align: center;
  background: var(--brand); color: #fff; border-radius: 28rpx;
  font-size: 34rpx; font-weight: 600; margin-top: 36rpx;
}
.save-btn:active { opacity: .9; }
.save-btn.disabled { opacity: .7; }
.save-spinner {
  width: 34rpx; height: 34rpx; margin: 31rpx auto;
  border: 4rpx solid rgba(255,255,255,.35); border-top-color: #fff;
  border-radius: 50%; animation: spin .8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 删除 */
.delete-link {
  text-align: center; color: #fa5151; font-size: 28rpx; margin-top: 28rpx; padding: 12rpx 0;
}
.delete-link:active { opacity: .7; }
