/* pages/members/members.wxss */
.group { padding: 0 32rpx; }
.sec-title { font-size: 26rpx; color: var(--text-3); padding: 26rpx 0 4rpx; }
.mrow { display: flex; align-items: center; padding: 26rpx 0; position: relative; }
.mrow + .mrow::before { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 2rpx; background: #ececec; }
.av {
  width: 76rpx; height: 76rpx; border-radius: 50%; flex: none;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 30rpx; font-weight: 700; margin-right: 24rpx;
}
.nm { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 500; }
.nm .sub { display: block; font-size: 23rpx; color: #9a9a9a; font-weight: 400; margin-top: 8rpx; }
.tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 14rpx; background: #f2f3f5; color: #a0a0a0; flex: none; margin-right: 12rpx; }
.tag.own { background: #e8f8ee; color: #07C160; }
.chev { color: #cfcfcf; font-size: 34rpx; line-height: 1; flex: none; }
.pend-actions { display: flex; gap: 16rpx; flex: none; }
.p-ok, .p-no { padding: 10rpx 24rpx; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; }
.p-ok { background: #07C160; color: #fff; }
.p-no { background: #fff; color: #b08900; box-shadow: inset 0 0 0 2rpx #e8d9a8; }
