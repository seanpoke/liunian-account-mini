/* pages/stats/stats.wxss */
.fs24 { font-size: 24rpx; }
/* 区块标题（原型 .sec-title） */
.section-title { font-size: 28rpx; color: #9a9a9a; margin: 28rpx 8rpx 14rpx; }
.seg { display: flex; background: #f2f3f5; border-radius: 24rpx; padding: 8rpx; margin-bottom: 20rpx; }
.seg-opt { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 18rpx; font-size: 28rpx; color: var(--text-2); }
.seg-opt.on { background: #fff; color: var(--brand); font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }

.period-pick { margin: 16rpx 0; }
.pick-box { background: #fff; border-radius: 14rpx; padding: 18rpx 24rpx; font-size: 28rpx; }

.chip-label { font-size: 24rpx; color: var(--text-3); margin: 24rpx 8rpx 8rpx; }
.filter-row { white-space: nowrap; margin: 8rpx 0 20rpx; }
.chip { display: inline-block; padding: 12rpx 26rpx; background: #f2f3f5; border-radius: 40rpx; font-size: 26rpx; color: #666; margin-right: 12rpx; }
.chip.on { background: var(--brand); color: #fff; font-weight: 600; }

/* 三数字卡（对照原型 .sum-row） */
.sum-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.s { flex: 1; background: #fff; border-radius: 24rpx; padding: 24rpx; text-align: center; box-shadow: 0 6rpx 24rpx rgba(31, 35, 41, 0.04); }
.s .l { font-size: 24rpx; color: var(--text-3); }
.s .v { font-size: 36rpx; font-weight: 700; margin-top: 8rpx; }

.chart-lg { width: 100%; height: 320rpx; }
.chart-ring { width: 280rpx; height: 280rpx; flex: none; }

/* 多人趋势图例 */
.trend-legend { display: flex; flex-wrap: wrap; padding: 16rpx 16rpx 0; }
.tl-item { display: flex; align-items: center; font-size: 24rpx; color: var(--text-2); margin-right: 28rpx; margin-bottom: 8rpx; }
.tl-line { width: 28rpx; height: 6rpx; border-radius: 3rpx; margin-right: 8rpx; }
.ring-legend { padding-left: 16rpx; }
.legend-row { display: flex; align-items: center; padding: 8rpx 0; font-size: 26rpx; }
.legend-row .dot { width: 18rpx; height: 18rpx; border-radius: 6rpx; margin-right: 12rpx; flex: none; }
.fs24 { font-size: 24rpx; }
