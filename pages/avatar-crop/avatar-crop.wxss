/* pages/avatar-crop/avatar-crop.wxss */
.ac-page {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #000;
  overflow: hidden;
}

/* 裁剪圆：图片裁到圆内，圆外就是纯黑背景 */
.ac-stage {
  position: fixed;
  left: 50%;
  border-radius: 50%;
  overflow: hidden;
  background: #111;
}
.ac-img {
  position: absolute;
}

/* 圆环描边 */
.ac-ring {
  position: fixed;
  left: 50%;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  pointer-events: none;
}

.ac-tip {
  position: fixed;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.62);
}

.ac-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(52rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
}
.ac-btn {
  width: 240rpx;
  height: 88rpx;
  margin: 0 20rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}
.ac-btn.cancel {
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
}
.ac-btn.ok {
  background: #07C160;
  color: #fff;
  font-weight: 600;
}
.ac-btn.disabled {
  opacity: 0.6;
}
