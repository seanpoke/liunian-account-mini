/* pages/category-picker/category-picker.wxss */
.cp-page {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 1;
  background: #fff; display: flex; flex-direction: column;
}
.cp-head {
  flex: none;
  border-bottom: 1rpx solid #f2f3f5;
}
/* 导航条：高度与微信胶囊对齐，中间放收支切换，右侧放「取消」 */
.cp-bar {
  position: relative;
  display: flex; align-items: center; justify-content: center;
}
.cp-tabs { display: flex; align-items: center; height: 100%; }
.cp-tab {
  position: relative; height: 100%;
  display: flex; align-items: center; padding: 0 36rpx;
  font-size: 32rpx; color: #9a9a9a;
}
.cp-tab.on { color: #1a1a1a; font-weight: 600; }
.cp-tab.on::after {
  content: ''; position: absolute; left: 50%; bottom: 0;
  width: 44rpx; height: 6rpx; margin-left: -22rpx;
  background: #07C160; border-radius: 3rpx;
}
.cp-cancel {
  position: absolute; left: 8rpx; top: 50%; transform: translateY(-50%);
  font-size: 30rpx; color: #646a73; padding: 16rpx 24rpx;
}
.cp-cancel:active { opacity: .6; }

.cp-body { flex: 1; min-height: 0; }
.cp-sec-title {
  font-size: 24rpx; color: #9a9a9a;
  padding: 24rpx 24rpx 0;
}
.cp-grid { display: flex; flex-wrap: wrap; padding: 12rpx 12rpx 8rpx; }
.cp-cell {
  width: 25%; display: flex; flex-direction: column; align-items: center;
  padding: 22rpx 0;
}
.cp-ic {
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: #f5f6f8; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  font-size: 46rpx; line-height: 1; box-sizing: border-box; padding: 0 6rpx;
}
.cp-cell:active .cp-ic { background: #eceef1; }
/* 当前已选中的分类 */
.cp-cell.on .cp-ic {
  background: #e8f8ef; color: #07C160;
  border: 2rpx solid #07C160; box-sizing: border-box;
}
.cp-cell.on .cp-name { color: #07C160; font-weight: 600; }
.cp-ic-add {
  background: #fff; border: 2rpx dashed #d8d8d8; color: #bbb;
  box-sizing: border-box; font-size: 40rpx;
}
.cp-name {
  font-size: 24rpx; color: #646a73; margin-top: 14rpx;
  max-width: 160rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.cp-tip {
  text-align: center; font-size: 22rpx; color: #c4c4c4;
  padding: 16rpx 0 calc(32rpx + env(safe-area-inset-bottom));
}

/* ===== 新增分类弹层（与记账弹层同一套交互） ===== */
.cat-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .45); z-index: 3000;
  opacity: 0; visibility: hidden; transition: opacity .22s, visibility .22s;
}
.cat-mask.show { opacity: 1; visibility: visible; }

.cat-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 3001;
  background: #fff; border-radius: 36rpx 36rpx 0 0;
  padding: 0 32rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%); visibility: hidden;
  transition: transform .28s cubic-bezier(.2, .8, .2, 1), visibility .28s;
  max-height: 90vh; overflow-y: auto;
}
.cat-sheet.show { transform: translateY(0); visibility: visible; }

.cat-handle {
  height: 48rpx; margin: 0 -32rpx;
  display: flex; align-items: center; justify-content: center;
}
.cat-handle::after {
  content: ''; width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #e0e0e0;
}

.cat-sheet-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8rpx 4rpx 34rpx;
}
.cat-sheet-title { font-size: 38rpx; font-weight: 700; color: #1a1a1a; }
.cat-close {
  width: 48rpx; height: 48rpx; border-radius: 50%; background: #f2f3f5;
  color: #888; font-size: 34rpx; line-height: 46rpx; text-align: center;
}
.cat-close:active { background: #e8e8e8; }

.cat-field-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 4rpx 16rpx;
}
.cat-field-label { font-size: 28rpx; color: #333; }
.cat-field-link { font-size: 26rpx; color: #9a9a9a; }
.cat-field-link:active { opacity: .7; }
.cat-field-count { font-size: 24rpx; color: #b0b0b0; }

.cat-input-box {
  display: flex; align-items: center;
  height: 100rpx; padding: 0 28rpx;
  background: #f7f8fa; border: 2rpx solid #f0f0f0; border-radius: 20rpx;
}
.cat-input {
  flex: 1; height: 100rpx; line-height: 100rpx;
  font-size: 30rpx; color: #1a1a1a;
}
.cat-input-ph { color: #b8b8b8; }
.cat-input-preview { font-size: 40rpx; margin-left: 16rpx; }

.cat-field-tip { font-size: 22rpx; color: #b0b0b0; margin: 12rpx 4rpx 34rpx; }

.cat-sheet-actions { display: flex; gap: 20rpx; margin-top: 48rpx; }
.cat-btn {
  height: 96rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; font-weight: 600;
}
.cat-btn.cancel {
  width: 200rpx; flex: none; background: #fff; color: #333;
  border: 2rpx solid #e5e5e5;
}
.cat-btn.ok { flex: 1; background: #07C160; color: #fff; }
.cat-btn.ok:active { opacity: .9; }
.cat-btn.disabled { opacity: .6; }
.cat-btn.cancel:active { background: #f7f7f7; }
