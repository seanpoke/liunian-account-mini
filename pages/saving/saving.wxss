/* pages/saving/saving.wxss —— 家庭储蓄页
   颜色语义：存入 = income 绿；取出 = saving-out 橙（不是 expense 红）；转账 = 灰 */
.pad { padding: 24rpx; }

.nav-action {
  font-size: 26rpx;
  color: var(--brand);
  padding: 12rpx 8rpx;
}

/* ---------------- 余额卡 ----------------
   与首页 hero 同一套视觉：品牌绿实底 + 白字 + 白色半透明分隔线。
   储蓄页里白底黑字和账户卡、流水卡同色，看起来像个能点进去编辑的字段；实底绿卡才像"资产展示"。 */
.bal-card {
  background: linear-gradient(135deg, #07C160, #0aa85a);
  border-radius: 36rpx;
  padding: 34rpx 32rpx 30rpx;
  color: #fff;
  box-shadow: 0 14rpx 36rpx rgba(7, 193, 96, .25);
}
.bc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.bc-title-wrap { display: flex; flex-direction: column; min-width: 0; }
.bc-title { font-size: 28rpx; font-weight: 600; letter-spacing: .5rpx; }
.bc-sub { font-size: 22rpx; color: rgba(255, 255, 255, .78); margin-top: 6rpx; }
/* 更新余额收成半透明白胶囊：常驻但不抢视线 */
.bc-adjust {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, .22);
  border: 1rpx solid rgba(255, 255, 255, .45);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
}
.bc-adjust:active { background: rgba(255, 255, 255, .34); }
.bc-num {
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  margin: 18rpx 0 22rpx;
  font-variant-numeric: tabular-nums;
}
.bc-stats {
  display: flex;
  align-items: stretch;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, .28);
}
.bc-stat { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.bc-stat:last-child { align-items: flex-end; text-align: right; }
.bc-div { width: 1rpx; background: rgba(255, 255, 255, .28); margin: 4rpx 24rpx; flex: none; }
.bs-k { font-size: 22rpx; color: rgba(255, 255, 255, .8); }
.bs-v {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}
.bs-v.in, .bs-v.out { color: #fff; }

/* ---------------- 账户横滚 ---------------- */
.acct-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 8rpx 16rpx;
}
.acct-h { font-size: 26rpx; color: var(--text-2); font-weight: 600; }
/* 账户多时不用横向滑：右侧给一个总入口 */
.acct-more { font-size: 24rpx; color: var(--text-2); padding: 6rpx 4rpx; }
.acct-strip {
  white-space: nowrap;
  width: 100%;
  padding: 2rpx 2rpx 10rpx;
  box-sizing: border-box;
}
/* 账户卡：固定 212×132，上行名称 23rpx 灰字、下行金额 34rpx 加粗——
   主次只靠字号与字重区分，不加底色块、不堆标签，横滚一排看过去是齐的 */
.acct {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 212rpx;
  height: 132rpx;
  padding: 22rpx 22rpx 20rpx;
  margin-right: 16rpx;
  background: var(--card);
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 2rpx 10rpx rgba(17, 24, 39, .04);
  box-sizing: border-box;
  vertical-align: top;
}
.acct:last-child { margin-right: 2rpx; }
/* 选中：白底 + 绿描边 + 极轻投影，比整块浅绿底更干净，也不会和余额卡的绿打架 */
.acct.on {
  background: #fff;
  border-color: var(--brand);
  box-shadow: 0 6rpx 18rpx rgba(7, 193, 96, .16);
}
/* 选中：名称与金额一起染绿，配合绿描边强化"当前筛选" */
.acct.on .an { color: #0b7a44; font-weight: 600; }
.acct.on .ab { color: #0b7a44; }
.acct.off { opacity: .5; }
.an {
  font-size: 23rpx;
  color: var(--text-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ab {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -.5rpx;
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ab.gray {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-3);
  letter-spacing: 0;
}
.tag-off {
  align-self: flex-start;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #a0a0a0;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
}

/* ---------------- 流水 ---------------- */
/* 月份头：左边两行（月份 + 存取明细），右边单独一列「当月差额」。
   原来 `+X / −Y` 挤在一行且没有净额，用户既看不清分隔，也看不到这个月到底多了多少 */
.month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 8rpx 16rpx;
}
.mh-left { display: flex; flex-direction: column; min-width: 0; }
.mh-month { font-size: 26rpx; font-weight: 600; color: var(--text); }
.mh-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}
.mh-net {
  flex: none;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.mh-net-k { font-size: 20rpx; color: var(--text-3); }
.mh-net-v {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}
.mh-sign {
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 8rpx;
}
.mh-num {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -.5rpx;
}
/* 当月差额：颜色直接挂在符号与数字上（不走后代选择器，避免被 .mh-num 的基础色盖掉） */
.mh-sign.in, .mh-num.in { color: var(--income); }
.mh-sign.out, .mh-num.out { color: var(--saving-out); }
.mh-sign.flat, .mh-num.flat { color: var(--text-3); }

.trans-card { background: var(--card); border-radius: 28rpx; padding: 4rpx 28rpx; }
.trans {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.trans:last-child { border-bottom: none; }
.trans .ic {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #f2f3f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex: none;
}
.trans .mid { flex: 1; min-width: 0; }
.trans .line1 {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.trans .tcat {
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  white-space: nowrap;
}
.tag-save {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #0b7a44;
  background: var(--brand-soft);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}
/* 金额：数字一律深色（这一页的主色已经被绿色余额卡占满，行内再用彩色数字就没有重点了），
   方向只由小一号的 +/− 承担；符号与数字之间留 10rpx，不再挤成「+¥200.00」 */
.trans .amt {
  display: flex;
  align-items: baseline;
  flex: none;
  margin-left: 16rpx;
  font-variant-numeric: tabular-nums;
}
.amt-sign {
  font-size: 25rpx;
  font-weight: 600;
  margin-right: 10rpx;
}
.amt-num {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -.5rpx;
}
/* 符号与数字同色：存绿取橙，方向一眼可辨；颜色只在这两处出现，不与余额卡打架 */
.amt.inc .amt-sign, .amt.inc .amt-num { color: var(--income); }
.amt.out .amt-sign, .amt.out .amt-num { color: var(--saving-out); }
.amt.gray .amt-num { color: var(--text-2); }
.trans .note {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.load-tip {
  text-align: center;
  font-size: 23rpx;
  color: #c0c0c0;
  padding: 28rpx 0 8rpx;
}

/* 空态 */
.empty { padding: 120rpx 0 40rpx; text-align: center; }
.empty-ic { font-size: 80rpx; opacity: .5; }
.empty-t { font-size: 28rpx; color: var(--text-2); margin-top: 16rpx; }
.empty-s { font-size: 23rpx; color: var(--text-3); margin-top: 8rpx; }

.action-clear { height: 200rpx; }

/* ---------------- 底部操作条 ---------------- */
.act-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, .96);
  border-top: 1rpx solid var(--line);
  z-index: 30;
}
.act-bar button {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  font-size: 31rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
}
.act-bar button::after { border: none; }
/* 转账：次级，固定宽度靠左；存入：主操作，占满剩余宽度靠右（拇指区） */
.act-bar .b1 { flex: 0 0 210rpx; background: #f2f3f5; color: var(--text); margin-right: 20rpx; }
.act-bar .b1.off { color: #c9cdd4; }
.act-bar .b2 { background: var(--brand); color: #fff; }

/* ---------------- 弹层 ---------------- */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, .45);
  z-index: 40;
  opacity: 0;
  visibility: hidden;
  transition: opacity .2s;
}
.mask.show { opacity: 1; visibility: visible; }

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  max-height: 88vh;
  overflow-y: auto;
  z-index: 41;
  transform: translateY(100%);
  visibility: hidden;
  transition: transform .26s ease, visibility .26s;
}
.sheet.show { transform: translateY(0); visibility: visible; }
.sheet.pick { max-height: 62vh; }
.handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e2e2e2;
  margin: 0 auto 20rpx;
}
.sheet-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
/* 只有「取消」没有标题的弹层（修改流水）：关闭动作放右上角，符合用户对弹层的肌肉记忆 */
.sheet-bar { display: flex; justify-content: flex-end; margin: -12rpx 0 0; }
.sheet-cancel { font-size: 27rpx; color: var(--text-2); padding: 10rpx 4rpx; }

/* 存入 / 取出分段器：居中胶囊，选中项白底 + 类型色（绿=存入，橙=取出） */
.seg {
  display: flex;
  width: 320rpx;
  margin: 4rpx auto 12rpx;
  padding: 6rpx;
  background: #f2f3f5;
  border-radius: 999rpx;
}
.seg-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--text-2);
  border-radius: 999rpx;
}
.seg-item.on {
  background: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, .08);
}
.seg-item.on.in { color: var(--brand); }
.seg-item.on.out { color: var(--saving-out); }

/* 结果预览：存入 → 存后余额；取出 → 取后余额（超限变红） */
.preview {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  margin: -8rpx 0 16rpx;
}
.preview.bad { color: var(--expense); }

/* 金额：与记账页 record-sheet 完全同款（居中、80rpx、无 ¥ 前缀），保证两个弹层观感一致 */
.amount-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 24rpx;
}
.amount-input {
  flex: 1;
  font-size: 80rpx;
  font-weight: 700;
  text-align: center;
  color: #1a1a1a;
  height: 100rpx;
}
.amount-ph { color: #c8ccd2; }
.amount-wrap.err .amount-input { color: var(--expense); }

.quick {
  display: flex;
  justify-content: center;
  margin: 0 0 24rpx;
}
.quick text {
  font-size: 24rpx;
  color: var(--text-2);
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 12rpx 24rpx;
  margin: 0 8rpx;
}

/* 转账：方向即标题。两列都居中对齐（不再左右贴边），中间 88rpx 圆形箭头——点它互换两头 */
.pair {
  display: flex;
  align-items: center;
  padding: 8rpx 0 24rpx;
}
.pair-side {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 8rpx;
}
.pair-side:active { opacity: .7; }
.pair-lbl { font-size: 22rpx; color: var(--text-3); }
/* 账户名与余额同一行：避免「角色 / 账户 / 可用金额」三层堆叠，两行就读完 */
.pair-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  max-width: 100%;
  margin-top: 10rpx;
}
.pair-name {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.pair-bal {
  flex: none;
  margin-left: 10rpx;
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}
.pair-arrow {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  margin: 0 8rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 44rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.pair-arrow:active { background: #cfeee0; }

.info-card {
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  font-size: 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.field.last { border-bottom: none; }
.field .lbl { color: var(--text); }
.field .v { color: #333; font-size: 28rpx; }
.field .v.strong { font-weight: 600; }
/* 不可修改的行整行置灰 + 标签：一眼看出这行点不动，而不是点了没反应 */
.field.ro .lbl, .field.ro .v { color: #b9bec7; }
.ro-tag {
  font-size: 20rpx;
  color: #a8adb8;
  background: #f2f3f5;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 12rpx;
}
.v-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  margin-left: 24rpx;
}
.v-input.right { text-align: right; }
.ph { color: #c4c4c4; }



.err { font-size: 24rpx; color: var(--expense); margin: 4rpx 0 8rpx; text-align: center; }

/* 主按钮：与记账弹层 `.save-btn` 同规格（96rpx 高、28rpx 圆角、34rpx 字、整宽）
   用 view 而非原生 button —— button 在小程序里有自己的默认盒模型，宽度会被压窄 */
.save {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 28rpx;
  background: var(--brand);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 36rpx;
  box-sizing: border-box;
}
.save:active { opacity: .9; }
/* 取出用橙色主按钮，与分段器选中色一致 */
.save.out { background: var(--saving-out); }
.save.disabled { background: #c9cdd4; }
.hint { font-size: 23rpx; color: var(--text-3); line-height: 1.6; margin-top: 16rpx; }

/* 更新余额：顶部标题 + 右上角取消；账面余额做成一行灰字参照，金额单独居中大号输入 */
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.sh-title { font-size: 32rpx; font-weight: 600; }
.sh-cancel { font-size: 27rpx; color: var(--text-2); padding: 6rpx 4rpx; }
/* 更新余额的金额输入：¥ + 右对齐数字，装在标准字段行里，一眼知道这里要填 */
.money-wrap { display: flex; align-items: center; }
.money-cur { font-size: 30rpx; font-weight: 600; color: var(--text); margin-right: 8rpx; }
.money-input {
  width: 300rpx;
  text-align: right;
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  font-variant-numeric: tabular-nums;
}
.preview.live { color: var(--text); font-weight: 600; }
/* 账户面板底部的「添加 / 管理账户」 */
.pick-foot {
  margin-top: 20rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  font-size: 27rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 20rpx;
}
.pick-foot:active { opacity: .8; }
.confirm {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.cb {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #c9cdd4;
  border-radius: 8rpx;
  margin-right: 12rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.cb.on { background: var(--brand); border-color: var(--brand); }

/* 账户选择 */
.pick-hint { font-size: 23rpx; color: var(--text-3); margin-bottom: 12rpx; }
.pick-list { max-height: 44vh; overflow-y: auto; }
.pick-row {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  border-bottom: 1rpx solid var(--line);
}
.pick-row:last-child { border-bottom: none; }
/* 置灰：转账两头互为不可选项 */
.pick-row.off { opacity: .38; }
/* 图标：72rpx 圆角方块 + 浅灰底，比原来 64rpx 更稳，emoji 也不至于糊成一团 */
.pi {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #f4f6f8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
  margin-right: 20rpx;
  flex: none;
}
/* 勾选紧跟账户名，不再飘到金额后面；金额固定靠右 */
.pn {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  font-size: 29rpx;
}
.ck { margin-left: 10rpx; font-size: 26rpx; color: var(--brand); flex: none; }
.pb {
  flex: none;
  margin-left: 16rpx;
  font-size: 25rpx;
  color: var(--text-2);
  font-variant-numeric: tabular-nums;
}
