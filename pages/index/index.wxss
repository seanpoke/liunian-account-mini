/* pages/index/index.wxss —— 对照 doc/家庭记账小程序原型.html 首页 */

/* ===== 绿色 Hero ===== */
.hero {
  background: linear-gradient(135deg, #07C160, #0aa85a);
  border-radius: 36rpx;
  padding: 36rpx 36rpx 28rpx;
  color: #fff;
  box-shadow: 0 14rpx 36rpx rgba(7, 193, 96, 0.25);
}
.hero-top { display: flex; justify-content: space-between; align-items: center; }
.hero-month { font-size: 28rpx; opacity: .92; }
.hero-av {
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .22);
  border: 3rpx solid rgba(255, 255, 255, .65);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700;
}
/* 「本月结余」+ 盈余/超支胶囊：一眼知道这个月是赚是亏，不用自己算正负 */
.hero-label-line { display: flex; align-items: center; margin-top: 20rpx; }
.hero-label { font-size: 24rpx; opacity: .85; }
.hero-badge {
  margin-left: 12rpx;
  font-size: 20rpx;
  line-height: 1;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .24);
  border: 1rpx solid rgba(255, 255, 255, .38);
}
.hero-badge.neg { background: rgba(255, 255, 255, .14); }
.hero-balance { font-size: 72rpx; font-weight: 700; margin: 8rpx 0 24rpx; letter-spacing: 1rpx; }
.hero-stats { display: flex; align-items: stretch; }
.hs-col { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.hs-col.right { padding-left: 36rpx; }
.hs-div { width: 1rpx; background: rgba(255, 255, 255, .3); margin: 4rpx 0; flex: none; }
.hs-k { font-size: 23rpx; opacity: .8; }
.hs-v { font-size: 32rpx; font-weight: 600; margin-top: 6rpx; font-variant-numeric: tabular-nums; }
.mini-trend { margin-top: 26rpx; }
.mini-canvas { width: 100%; height: 72rpx; display: block; }
.hero-go { display: flex; justify-content: flex-end; font-size: 24rpx; opacity: .78; margin-top: 12rpx; }

/* ===== 区块标题（原型 .sec-title） ===== */
.section-title { font-size: 28rpx; color: #9a9a9a; margin: 32rpx 8rpx 16rpx; }

/* ===== 今日三栏 ===== */
.today { display: flex; align-items: stretch; padding: 12rpx 8rpx; margin-top: 20rpx; border-radius: 28rpx; box-shadow: none; }
.t-col { flex: 1; text-align: center; padding: 20rpx 0; }
.t-l { font-size: 24rpx; color: var(--text-3); }
.t-num { font-size: 40rpx; }
.t-unit { font-size: 24rpx; color: var(--text-2); }
.t-sep { width: 2rpx; background: var(--line); margin: 20rpx 0; }

/* ===== 最近 5 天分组列表（对照原型：单一 trans-card 包裹全部日期分组） ===== */
.trans-card { background: #fff; border-radius: 28rpx; padding: 8rpx 28rpx; }
.day-group { padding-bottom: 8rpx; }
.day-head { display: flex; justify-content: space-between; align-items: center; padding: 32rpx 4rpx 16rpx; }
.day-title { font-size: 25rpx; font-weight: 600; color: var(--text-2); }
.day-week { font-size: 22rpx; color: var(--text-3); }
.tx-row { display: flex; align-items: center; padding: 24rpx 0; }
.tx-row + .tx-row { border-top: 2rpx solid var(--line); }
.tx-ic {
  width: 80rpx; height: 80rpx; border-radius: 24rpx;
  background: #F2F3F5;
  display: flex; align-items: center; justify-content: center;
  font-size: 42rpx; flex: none;
}
.tx-mid { flex: 1; min-width: 0; margin-left: 24rpx; }
.tx-cat-wrap { display: flex; align-items: center; min-width: 0; }
.tx-cat { font-size: 30rpx; font-weight: 600; }
.tx-img-tag {
  margin-left: 12rpx; padding: 0 10rpx;
  height: 32rpx; line-height: 32rpx; box-sizing: border-box;
  font-size: 20rpx; font-weight: 400; color: #8a8f99;
  background: #f2f3f5; border-radius: 8rpx; flex: none;
}
/* 「储蓄」小标 */
.tx-save-tag {
  margin-left: 10rpx; padding: 0 8rpx;
  height: 30rpx; line-height: 30rpx;
  font-size: 19rpx; font-weight: 400; color: #0b7a44;
  background: var(--brand-soft); border-radius: 6rpx; flex: none;
}
.tx-amt { font-size: 32rpx; font-weight: 600; flex: none; }
.tx-sub {
  font-size: 24rpx; color: var(--text-3); margin-top: 6rpx;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.day-sum {
  display: flex; justify-content: flex-end; gap: 22rpx;
  font-size: 22rpx; color: #b0b0b0;
  padding: 12rpx 4rpx 24rpx;
  border-bottom: 2rpx solid var(--line);
}
.day-sum .bold { color: #8a8a8a; }
.day-sum .income { color: var(--income); }
.day-sum .expense { color: var(--expense); }

/* ===== 悬浮记一笔：圆形 + ===== */
.fab {
  position: fixed; left: 50%; transform: translateX(-50%);
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  width: 108rpx; height: 108rpx; border-radius: 50%;
  background: #07C160; color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; font-weight: 400; line-height: 1;
  border: 8rpx solid #ffffff;
  box-shadow: 0 14rpx 32rpx rgba(7, 193, 96, 0.45);
  z-index: 30;
}

/* ===== 家庭储蓄卡（第二本账入口）=====
   位置：Hero 与「今日」之间。与 Hero 同为"实底展示卡"，但用深一档的绿区隔：
   两张同亮度绿卡上下叠会分不清主次，浅绿底又会被当成可编辑的普通卡片 */
.saving-card {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #0f8a53 0%, #0a5f3a 100%);
  border-radius: 30rpx;
  color: #fff;
  box-shadow: 0 12rpx 30rpx rgba(10, 95, 58, .22);
}
.sc-main { flex: 1; min-width: 0; }
.sc-top { display: flex; align-items: center; }
.sc-ic { font-size: 28rpx; margin-right: 8rpx; }
.sc-name { font-size: 26rpx; font-weight: 600; color: rgba(255, 255, 255, .92); }
.sc-bal {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 8rpx;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}
.sc-io { font-size: 23rpx; color: rgba(255, 255, 255, .75); margin-top: 8rpx; }
.sc-io .inc, .sc-io .out { color: #fff; font-weight: 600; }
.sc-actions {
  flex: none;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}
.sc-btn {
  flex: none;
  width: 132rpx;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #fff;
  color: #0a7a47;
  font-size: 25rpx;
  font-weight: 600;
}
/* 取出：深底上的描边按钮（取出不是支出，不用 expense 红） */
.sc-btn.ghost {
  margin-top: 12rpx;
  background: rgba(255, 255, 255, .12);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, .55);
  line-height: 58rpx;
}
