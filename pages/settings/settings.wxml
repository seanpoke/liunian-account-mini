<!-- pages/settings/settings.wxml —— 完全对照 doc/家庭记账小程序原型.html「我的」页 -->
<view class="page">
  <navigation-bar title="我的" back="{{false}}" color="black" background="#f2f3f5"></navigation-bar>
  <view class="page-body pad">

    <!-- 家庭卡 -->
    <view class="fam-card">
      <view class="fam-av" bindtap="changeFamilyAvatar">
        <image wx:if="{{familyAvatarUrl && !familyAvatarError}}" class="fam-av-img"
               src="{{familyAvatarUrl}}" mode="aspectFill" binderror="onFamilyAvatarError" />
        <image wx:else class="fam-av-ic" src="{{iconHouse}}" mode="aspectFit" />
      </view>
      <view class="fam-info">
        <view class="fam-name">{{familyName}}</view>
        <view class="fam-sub">{{memberCount}} 位成员 · 本月 {{monthCount}} 笔</view>
      </view>
      <view class="fam-invite" bindtap="invite">＋ 邀请</view>
    </view>

    <!-- 待审批申请 -->
    <view class="sec-title">待审批申请<view wx:if="{{pending.length}}" class="badge">{{pending.length}}</view></view>
    <block wx:if="{{pending.length}}">
      <view class="pend" wx:for="{{pending}}" wx:key="requestId">
        <view class="pend-top">
          <image wx:if="{{item.avatarUrl}}" class="av" src="{{item.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="av" style="background:{{item.bg}};">{{item.initial}}</view>
          <view class="pend-info">
            <view class="pend-nm">{{item.nickname}}</view>
            <view class="pend-sub">{{item.sub}}</view>
          </view>
        </view>
        <view class="pend-actions">
          <view class="p-no" bindtap="reject" data-id="{{item.requestId}}">拒绝</view>
          <view class="p-ok" bindtap="approve" data-id="{{item.requestId}}">同意加入</view>
        </view>
      </view>
    </block>
    <view wx:else class="empty">暂无待审批申请</view>

    <!-- 家庭成员 -->
    <view class="sec-title">家庭成员<text class="cnt">{{memberCount}}</text></view>
    <view class="group">
      <view class="mrow" wx:for="{{members}}" wx:key="memberId" data-id="{{item.memberId}}" bindtap="tapMember">
        <image wx:if="{{item.avatarUrl}}" class="av" src="{{item.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="av" style="background:{{item.bg}};">{{item.initial}}</view>
        <view class="nm">{{item.displayName}}<text class="sub">{{item.sub}}</text></view>
        <view class="tag {{item.role === 'owner' ? 'own' : ''}}">{{item.role === 'owner' ? '创建者' : '成员'}}</view>
        <text class="chev">›</text>
      </view>
    </view>

    <!-- 家庭设置 -->
    <view class="sec-title">家庭设置</view>
    <view class="group">
      <view class="srow" bindtap="tapTransfer">
        <view class="lbl">转让创建者</view>
        <view class="val">{{ownerName}}</view>
        <text class="chev">›</text>
      </view>
      <view class="srow" bindtap="switchFamily">
        <view class="lbl">切换家庭</view>
        <text class="chev">›</text>
      </view>
      <view class="srow" bindtap="tapQuit">
        <view class="lbl">退出家庭</view>
        <text class="chev">›</text>
      </view>
      <view wx:if="{{isOwner}}" class="srow" bindtap="tapDissolve">
        <view class="lbl danger">解散家庭</view>
        <text class="chev">›</text>
      </view>
      <view class="srow" bindtap="goPrivacy">
        <view class="lbl">隐私政策</view>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="tab-clear"></view>
  </view>

  <!-- 成员操作弹层 -->
  <view class="m-mask {{sheetShow ? 'show' : ''}}" bindtap="closeMemberSheet"></view>
  <view class="m-sheet {{sheetShow ? 'show' : ''}}">
    <view class="mh">
      <image wx:if="{{sheetMember.avatarUrl}}" class="m-av" src="{{sheetMember.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="m-av" style="background:{{sheetMember.bg}};">{{sheetMember.initial}}</view>
      <view class="m-nm">{{sheetMember.nickname}}</view>
      <view class="m-sub">{{sheetMember.roleText}}{{sheetMember.joinText}}</view>
    </view>
    <view class="mstat">
      <view><text class="num">{{sheetMember.monthCount || 0}}</text>本月记账（笔）</view>
      <view><text class="num">{{sheetMember.totalCount || 0}}</text>累计记账（笔）</view>
    </view>
    <view wx:if="{{sheetActions.editSelf}}" class="maction" bindtap="editSelf">修改我的资料</view>
    <view wx:if="{{sheetActions.transfer}}" class="maction" bindtap="transfer">转让创建者给他</view>
    <view wx:if="{{sheetActions.remove}}" class="maction danger" bindtap="remove">移出家庭</view>
    <view wx:if="{{sheetActions.note}}" class="mnote">仅创建者可管理成员</view>
    <button class="mcancel" bindtap="closeMemberSheet">取消</button>
  </view>

  <!-- 邀请弹层 -->
  <view class="i-mask {{inviteShow ? 'show' : ''}}" bindtap="closeInvite"></view>
  <view class="i-sheet {{inviteShow ? 'show' : ''}}">
    <view class="ih">邀请家人一起记账</view>
    <view class="ih-sub">生成二维码，让家人面对面扫码加入</view>

    <view class="i-body">
      <view class="qr-box">
        <image class="qr-img" src="{{qrImageUrl}}" mode="aspectFit"></image>
        <view class="qr-label">让家人用微信「扫一扫」加入</view>
        <view class="qr-tip">邀请码 {{qrToken}} · 有效期 {{qrMeta.expireDays}} 天 · 限 {{qrMeta.memberLimit}} 人</view>
      </view>
      <view class="qr-row">
        <button class="btn-green" bindtap="saveQr">保存到相册</button>
      </view>
      <view class="i-tip">面对面扫码进入「提交加入申请」流程</view>
    </view>

    <button class="icancel" bindtap="closeInvite">取消</button>
  </view>

  <prompt-dialog visible="{{nameEditShow}}" title="{{nameEditTitle}}" value="{{nameEditValue}}"
                 placeholder="请输入" maxlength="{{10}}"
                 bind:confirm="onNameConfirm" bind:cancel="onNameCancel" />

  <record-sheet visible="{{sheetVisible}}" editId="{{sheetEditId}}" preset="{{sheetPreset}}" bind:close="onSheetClose" bind:saved="onSheetSaved" />
</view>
