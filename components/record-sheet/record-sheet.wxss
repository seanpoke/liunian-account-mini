/* components/record-sheet/record-sheet.wxss —— 原型 .mask / .sheet（px × 2 = rpx） */

.record-page {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  z-index: 2000; visibility: hidden; pointer-events: none;
}
.record-page.show { visibility: visible; pointer-events: auto; }

.record-backdrop {
  position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0, 0, 0, .4);
  opacity: 0; transition: opacity .25s ease;
}
.record-page.show .record-backdrop { opacity: 1; }
.record-page.closing .record-backdrop { opacity: 0; }

.record-sheet {
  position: absolute; left: 0; right: 0; bottom: 0; background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 24rpx 32rpx calc(28rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform .28s cubic-bezier(.2, .8, .2, 1), bottom .2s ease, max-height .2s ease;
  max-height: 88vh;
  /* 表单区自己滚动（见 .sheet-body），键盘弹出时可视高度变小也能滚到正在输入的位置 */
  display: flex; flex-direction: column; overflow: hidden;
}
.sheet-body { flex: 1 1 auto; min-height: 0; }
.record-page.show .record-sheet { transform: translateY(0); }
.record-page.closing .record-sheet { transform: translateY(100%); }

/* 顶部拖拽指示条（扩大触摸热区，支持下拉关闭） */
.sheet-handle {
  height: 56rpx; margin: 0 -32rpx 12rpx;
  display: flex; align-items: center; justify-content: center;
}
.sheet-handle::after {
  content: ''; width: 72rpx; height: 8rpx; border-radius: 4rpx; background: #ddd;
}

/* 金额 */
.amount-wrap {
  display: flex; align-items: center; justify-content: center;
  padding: 12rpx 0 24rpx;
}
.amount-input {
  flex: 1; font-size: 80rpx; font-weight: 700; text-align: center; color: #1a1a1a; height: 100rpx;
}
.amount-ph { color: #c8ccd2; }

/* 已选分类回显行（点击重开全屏分类页换分类） */
.cat-row {
  display: flex; align-items: center;
  background: #f7f8fa; border-radius: 24rpx;
  padding: 16rpx 24rpx; margin-bottom: 8rpx;
}
.cat-row:active { background: #eef0f2; }
.cr-ic {
  width: 56rpx; height: 56rpx; border-radius: 16rpx; overflow: hidden;
  background: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 34rpx; line-height: 1; flex: none;
}
.cr-name {
  font-size: 30rpx; color: #1a1a1a; font-weight: 600; margin-left: 16rpx;
  max-width: 320rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.cr-swap { margin-left: auto; font-size: 24rpx; color: #9a9a9a; }
.cr-arrow { font-size: 28rpx; color: #bbb; margin-left: 6rpx; }

/* 凭证图片 */
.img-card { margin-top: 16rpx; background: #fff; border-radius: 24rpx; border: 1rpx solid #f0f0f0; padding: 24rpx 24rpx 16rpx; }
.img-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.img-title { font-size: 28rpx; color: #1a1a1a; font-weight: 600; }
.img-tip { font-size: 22rpx; color: #b0b0b0; }
.img-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.img-item, .img-add {
  width: 148rpx; height: 148rpx; border-radius: 20rpx; overflow: hidden; position: relative; flex: none;
}
.img-thumb { width: 148rpx; height: 148rpx; display: block; }
.img-del {
  position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center;
  background: rgba(0,0,0,.55); color: #fff; font-size: 32rpx; border-bottom-left-radius: 20rpx;
}
.img-add {
  background: #f7f8fa; border: 2rpx dashed #dcdcdc; box-sizing: border-box;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.img-add-ic { font-size: 44rpx; color: #b8b8b8; line-height: 1; }
.img-add-txt { font-size: 22rpx; color: #9a9a9a; margin-top: 10rpx; }

/* 日期/备注卡片 */
.info-card {
  background: #fff; border-radius: 24rpx;
  border: 1rpx solid #f0f0f0; margin-top: 16rpx;
}
.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 28rpx; font-size: 30rpx;
}
.info-label { color: #1a1a1a; }
.info-value { color: #333; }
.info-arrow { color: #999; margin-left: 8rpx; }
.info-line { height: 1rpx; background: #f0f0f0; margin: 0 28rpx; }
.note-input {
  flex: 1; text-align: right; font-size: 30rpx; color: #333; margin-left: 32rpx;
}
.note-input::placeholder { color: #bbb; }

/* 保存 */
.save-btn {
  width: 100%; height: 96rpx; line-height: 96rpx; text-align: center;
  background: var(--brand); color: #fff; border-radius: 28rpx;
  font-size: 34rpx; font-weight: 600; margin-top: 36rpx;
}
.save-btn:active { opacity: .9; }
.save-btn.disabled { opacity: .7; }
.save-spinner {
  width: 34rpx; height: 34rpx; margin: 31rpx auto;
  border: 4rpx solid rgba(255,255,255,.35); border-top-color: #fff;
  border-radius: 50%; animation: rs-spin .8s linear infinite;
}
@keyframes rs-spin { to { transform: rotate(360deg); } }

/* 删除 */
.delete-link {
  text-align: center; color: #fa5151; font-size: 28rpx; margin-top: 28rpx; padding: 12rpx 0;
}
.delete-link:active { opacity: .7; }
