<!-- components/record-sheet/record-sheet.wxml —— 底部滑出记账表单（分类由全屏分类页选好后带入） -->
<view class="record-page {{shown ? 'show' : ''}} {{closing ? 'closing' : ''}}" catchtap="onBackdropTap">
  <view class="record-backdrop" catchtouchmove="preventTouchMove"></view>
  <!-- kbHeight：键盘弹出高度，弹层整体上移避让，避免备注被键盘遮挡 -->
  <view class="record-sheet" catchtap="stop" style="bottom: {{kbHeight}}px; max-height: {{kbHeight ? 'calc(100vh - ' + kbHeight + 'px)' : '88vh'}}; {{dragY > 0 ? 'transform: translateY(' + dragY + 'px); transition: none;' : ''}}">
    <view class="sheet-handle" catchtouchstart="onDragStart" catchtouchmove="onDragMove" catchtouchend="onDragEnd" catchtouchcancel="onDragEnd"></view>

    <!-- 表单区放在 scroll-view 里：键盘弹出后可视区域变小，可滚动并把正在输入的项带进视野 -->
    <scroll-view class="sheet-body" scroll-y scroll-into-view="{{scrollInto}}" scroll-with-animation="{{false}}">
      <!-- 已选分类：点击重开全屏分类选择页 -->
      <view id="f-cat" class="cat-row" bindtap="openAllCats">
        <view class="cr-ic">{{selectedIcon}}</view>
        <text class="cr-name">{{selectedName || '未选择分类'}}</text>
        <text class="cr-swap">更换分类</text>
        <text class="cr-arrow">›</text>
      </view>

      <view id="f-amount" class="amount-wrap">
        <input class="amount-input" type="digit" placeholder="0.00" placeholder-class="amount-ph" value="{{amountText}}" bindinput="onAmount" bindfocus="onAmountFocus" adjust-position="{{false}}" />
      </view>

      <!-- 储蓄联动（第二本账）：支出从储蓄支付 / 收入同时存入；夹在金额与信息卡之间 -->
      <block wx:if="{{!editId}}">
        <view class="saving-row">
          <view class="sr-left">
            <text class="sr-title">{{type === 'income' ? '同时存入家庭储蓄' : '从家庭储蓄支出'}}</text>
            <!-- 只有开启开关后才展示账户与错误；关着时保持干净的灰色一行 -->
            <text class="sr-sub" wx:if="{{savingOn && savingAcc}}">{{savingAcc.icon}} {{savingAcc.name}}</text>
          </view>
          <switch class="sr-switch" checked="{{savingOn}}" color="#07C160" bindchange="onSavingToggle" />
        </view>
        <view class="saving-fold" wx:if="{{savingOn && savingAcc}}">
          <view class="sf-row" bindtap="openSavingPick">
            <text class="sf-an">{{savingAcc.icon}} {{savingAcc.name}} ›</text>
            <text class="sf-tip">切换账户</text>
          </view>
          <view class="sf-row {{savingOver ? 'over' : ''}}">
            <text class="sf-bal">余额 ¥{{savingAccBalText}} → {{savingOver ? '不足' : '剩余'}} ¥{{savingLeftText}}</text>
          </view>
          <view class="sf-err" wx:if="{{savingOver}}">{{savingErr}}</view>
        </view>
      </block>
      <!-- 编辑已关联储蓄的记录：这笔支出的钱是从储蓄账户里取的，账户与关联都只读 -->
      <view class="saving-row readonly" wx:if="{{editId && savingLinked}}">
        <view class="sr-head">
          <text class="sr-title" wx:if="{{type === 'expense'}}">从「{{savingLinkedName}}」储蓄里支付</text>
          <text class="sr-title" wx:else>这笔钱存进了「{{savingLinkedName}}」</text>
          <text class="sr-lock">账户不可改</text>
        </view>
        <text class="sr-sub">{{type === 'expense' ? '这笔支出和一笔储蓄取出绑定：改金额，取出金额同步改' : '这笔收入和一笔储蓄存入绑定：改金额，存入金额同步改'}}</text>
        <text class="sr-sub" wx:if="{{type === 'expense' && savingCapText}}">最多能改成 ¥{{savingCapText}}（账户现有 ¥{{savingAccBalText}} + 本笔取出 ¥{{savingOriginalText}}）</text>
        <text class="sr-sub">{{type === 'expense' ? '想换储蓄账户或改成现金支付？删掉这笔，重新记一次' : '想换储蓄账户或不再存入？删掉这笔，重新记一次'}}</text>
      </view>

      <view class="info-card">
        <picker mode="date" value="{{date}}" bindchange="onDate">
          <view class="info-row">
            <text class="info-label">日期</text>
            <view class="info-value">{{date}} <text class="info-arrow">›</text></view>
          </view>
        </picker>
        <view class="info-line"></view>
        <picker mode="time" value="{{time}}" bindchange="onTime">
          <view class="info-row">
            <text class="info-label">时间</text>
            <view class="info-value">{{time}} <text class="info-arrow">›</text></view>
          </view>
        </picker>
        <view class="info-line"></view>
        <view id="f-note" class="info-row">
          <text class="info-label">备注</text>
          <input class="note-input" placeholder="写点什么…" value="{{note}}" bindinput="onNote" bindfocus="onNoteFocus" adjust-position="{{false}}" />
        </view>
      </view>

      <!-- 凭证图片：非必传，最多 3 张 -->
      <view class="img-card">
        <view class="img-head">
          <text class="img-title">凭证图片</text>
          <text class="img-tip">最多 {{imgMax}} 张 · 单张 ≤{{imgMaxText}}</text>
        </view>
        <view class="img-row">
          <view wx:for="{{images}}" wx:key="url" class="img-item">
            <image class="img-thumb" src="{{item.fullUrl}}" mode="aspectFill" data-url="{{item.fullUrl}}" bindtap="previewImage"></image>
            <view class="img-del" data-index="{{index}}" catchtap="removeImage">×</view>
          </view>
          <view wx:if="{{images.length < imgMax}}" class="img-add" bindtap="chooseImage">
            <text class="img-add-ic">＋</text>
            <text class="img-add-txt">{{uploading ? '上传中' : '添加'}}</text>
          </view>
        </view>
      </view>

      <view class="save-btn {{(saving || uploading) ? 'disabled' : ''}}" bindtap="save">
        <text wx:if="{{uploading && !saving}}">图片上传中…</text>
        <text wx:elif="{{!saving}}">保存</text>
        <view wx:else class="save-spinner"></view>
      </view>

      <view wx:if="{{editId}}" class="delete-link" bindtap="remove">删除这笔</view>
    </scroll-view>
  </view>
</view>
