/* components/prompt-dialog/prompt-dialog.wxss */
.pd-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45); z-index: 1000;
}
.pd-box {
  position: fixed; left: 50%; top: 50%; z-index: 1001;
  width: 600rpx; margin-left: -300rpx; margin-top: -196rpx;
  background: #fff; border-radius: 28rpx; padding: 40rpx 36rpx 0;
  box-sizing: border-box;
  opacity: 0; pointer-events: none; transform: scale(0.92);
  transition: opacity .18s ease, transform .18s ease;
}
.pd-box.show { opacity: 1; pointer-events: auto; transform: scale(1); }
.pd-title { font-size: 32rpx; font-weight: 600; text-align: center; color: #222; }
.pd-field { position: relative; margin-top: 30rpx; }
.pd-input {
  width: 100%; height: 88rpx; box-sizing: border-box;
  background: #f5f6fa; border-radius: 18rpx;
  padding: 0 88rpx 0 24rpx; font-size: 30rpx; color: #222;
}
.pd-ph { color: #b8b8b8; }
.pd-count {
  position: absolute; right: 22rpx; top: 0; line-height: 88rpx;
  font-size: 22rpx; color: #b8b8b8;
}
.pd-actions {
  display: flex; margin: 36rpx -36rpx 0;
  border-top: 1rpx solid #ececec;
}
.pd-btn {
  flex: 1; height: 96rpx; line-height: 96rpx; text-align: center;
  font-size: 32rpx;
}
.pd-btn.cancel { color: #7a7a7a; border-right: 1rpx solid #ececec; }
.pd-btn.ok { color: #07C160; font-weight: 600; }
.pd-btn:active { background: #f7f7f7; }
